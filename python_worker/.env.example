# Never commit real credentials or private keys.
SUPABASE_URL=
SUPABASE_KEY=
LOVABLE_BASE_URL=
BOT_SHARED_SECRET=
BOT_USER_ID=

# Execution engine: ccxt | hummingbot
EXECUTION_ENGINE=hummingbot
NO_LOSS_MODE=true
MIN_NET_PROFIT_USD=2.00
SAFETY_RESERVE_USD=1.00
MAX_NOTIONAL_USD=100.00
MAX_SLIPPAGE_BPS=20
QUOTE_MAX_AGE_MS=750

# CEX API credentials: use trade-only permissions, no withdrawals.
BINANCE_API_KEY=
BINANCE_SECRET=
KRAKEN_API_KEY=
KRAKEN_SECRET=

# Telegram control plane.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Hummingbot endpoint is an internal service; do not expose it publicly.
HUMMINGBOT_BASE_URL=http://127.0.0.1:8000
HUMMINGBOT_API_TOKEN=
