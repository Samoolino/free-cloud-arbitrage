# Never commit real credentials, seed phrases, or private keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
LOVABLE_BASE_URL=
BOT_SHARED_SECRET=
BOT_USER_ID=

# Execution engine: ccxt | hummingbot
EXECUTION_ENGINE=hummingbot
NO_LOSS_MODE=true
MIN_NET_PROFIT_USD=2.00
SAFETY_RESERVE_USD=1.00
MAX_NOTIONAL_USD=100.00
MAX_SLIPPAGE_BPS=20
QUOTE_MAX_AGE_MS=750

# CEX API credentials: use trade-only permissions, withdrawals disabled.
BINANCE_API_KEY=
BINANCE_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# DEX connectivity: read-only RPC/public configuration here; signing is external.
DEX_RPC_URL=
DEX_CHAIN_ID=

# Rotating working-capital loop.
CAPITAL_SOURCE_WALLET=
CAPITAL_SWEEP_WALLET=
CAPITAL_STARTING_USD=100.00
CAPITAL_MAX_WORKING_USD=100.00
TARGET_EQUITY_USD=150.00
MIN_PROFIT_PER_TRADE_USD=1.00
CAPITAL_RESERVE_RATIO=0.10
SIGNER_BACKEND=
SIGNER_KEY_REF=

# Telegram control plane.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Hummingbot endpoint is an internal service; do not expose it publicly.
HUMMINGBOT_BASE_URL=http://127.0.0.1:8000
HUMMINGBOT_API_TOKEN=
