# Bot authentication
LOVABLE_BASE_URL=https://your-app.example
BOT_SHARED_SECRET=replace-with-server-secret
BOT_USER_ID=replace-with-user-uuid

# Server-side credential encryption key (64 hex chars / 32 bytes)
EXCHANGE_CREDENTIALS_ENCRYPTION_KEY=replace-with-64-hex-character-key

# Real-time arbitrage
ARBITRAGE_EXCHANGES=binance,kraken,mexc,lbank,gate,bitfinex,fameex
ARBITRAGE_SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT
ARBITRAGE_INPUT_USDT=100
ARBITRAGE_MIN_PROFIT_USD=0.05
ARBITRAGE_MIN_PROFIT_PCT=0.10
ARBITRAGE_SLIPPAGE_BPS=5
ARBITRAGE_SAFETY_BPS=5
ARBITRAGE_MAX_QUOTE_AGE_MS=1000
EXECUTION_MAX_SLIPPAGE_BPS=20

# Optional per-exchange taker fee overrides (basis points)
# BINANCE_TAKER_FEE_BPS=10
# MEXC_TAKER_FEE_BPS=10
# LBANK_TAKER_FEE_BPS=10
# GATE_TAKER_FEE_BPS=10
